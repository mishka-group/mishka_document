<div>
  <.link
    navigate={
      path(
        @socket,
        (@return_to && "/admin/dashboard/document/sections/#{@return_to}") ||
          "/admin/dashboard/document"
      )
    }
    class="mb-[18px] inline-flex items-center gap-[7px] text-[12.5px] font-semibold text-[#8a877f] transition-colors hover:text-[#1b1a18]"
  >
    <.icon name="hero-chevron-left" class="size-[15px] rtl:rotate-180" />
    {(@return_to && gettext("Back to Sections")) || gettext("Back to Document Dashboard")}
  </.link>

  <.header>
    {gettext("Section Drafts")}
    <:subtitle>
      {gettext("Manage draft proposals for section changes with dual approval workflow.")}
    </:subtitle>
  </.header>

  <.modal id="section-draft-form-modal">
    <.live_component
      module={MishkaGervaz.Form.Web.Live}
      id="section_draft_form"
      resource={MishkaDocument.SectionDraft}
      current_user={@current_user}
    />
  </.modal>

  <.live_component
    :if={@url_state}
    module={MishkaGervaz.Table.Web.Live}
    id="section-drafts-table"
    resource={MishkaDocument.SectionDraft}
    current_user={@current_user}
    url_state={@url_state}
  >
    <:filter_actions>
      <button
        type="button"
        id="add-section-draft-btn"
        phx-click={show_form_modal("section-draft-form-modal", MishkaDocument.SectionDraft)}
        class="inline-flex h-[42px] items-center gap-2 rounded-xl bg-[linear-gradient(140deg,#6d69e6,#4f4bcc)] px-4 text-[12.5px] font-bold text-white shadow-[0_5px_14px_rgba(79,75,204,0.28)] transition-opacity hover:opacity-95"
      >
        <.icon name="hero-plus" class="size-4" /> {gettext("Add Section Draft")}
      </button>
    </:filter_actions>
  </.live_component>
</div>
