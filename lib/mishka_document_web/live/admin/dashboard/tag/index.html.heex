<div>
  <.link
    navigate={path(@socket, "/admin/dashboard/document")}
    class="mb-[18px] inline-flex items-center gap-[7px] text-[12.5px] font-semibold text-[#8a877f] transition-colors hover:text-[#1b1a18]"
  >
    <.icon name="hero-chevron-left" class="size-[15px] rtl:rotate-180" /> {gettext(
      "Back to Document Dashboard"
    )}
  </.link>

  <.header>
    {gettext("Document Tags")}
    <:subtitle>{gettext("Manage tags for organizing documentation sections.")}</:subtitle>
  </.header>

  <.modal id="document-tag-form-modal">
    <.live_component
      module={MishkaGervaz.Form.Web.Live}
      id="tag_form"
      resource={MishkaDocument.Tag}
      current_user={@current_user}
    />
  </.modal>

  <.live_component
    :if={@url_state}
    module={MishkaGervaz.Table.Web.Live}
    id="tags-table"
    resource={MishkaDocument.Tag}
    current_user={@current_user}
    url_state={@url_state}
  >
    <:filter_actions>
      <button
        type="button"
        id="add-document-tag-btn"
        phx-click={show_form_modal("document-tag-form-modal", MishkaDocument.Tag)}
        class="inline-flex h-[42px] items-center gap-2 rounded-xl bg-[linear-gradient(140deg,#6d69e6,#4f4bcc)] px-4 text-[12.5px] font-bold text-white shadow-[0_5px_14px_rgba(79,75,204,0.28)] transition-opacity hover:opacity-95"
      >
        <.icon name="hero-plus" class="size-4" /> {gettext("Add Tag")}
      </button>
    </:filter_actions>
  </.live_component>
</div>
