<div>
  <.link
    id="note-drafts-back"
    navigate={
      path(
        @socket,
        (@return_to && "/admin/dashboard/document/sections/#{@return_to}") ||
          "/admin/dashboard/document"
      )
    }
    class="mb-[18px] inline-flex items-center gap-[7px] text-[12.5px] font-semibold text-[#8a877f] transition-colors hover:text-[#1b1a18]"
  >
    <.icon name="hero-chevron-left" class="size-[15px] rtl:rotate-180" />
    {(@return_to && gettext("Back to Sections")) || gettext("Back to Document Dashboard")}
  </.link>

  <.header>
    {gettext("Note Drafts")}
    <:subtitle>
      {gettext("Manage draft proposals for note changes with dual approval workflow.")}
    </:subtitle>
  </.header>

  <.modal id="note-draft-form-modal">
    <.live_component
      module={MishkaGervaz.Form.Web.Live}
      id="note_draft_form"
      resource={MishkaDocument.NoteDraft}
      current_user={@current_user}
    />
  </.modal>

  <.modal
    id="note-draft-versions-modal"
    width_class="max-w-[840px]"
    padding_class="p-0"
    on_cancel={JS.push("close_versions")}
  >
    <CardChrome.modal_head
      icon="hero-clock"
      title={gettext("Version history")}
      subtitle={@versions_record_name || gettext("Loading…")}
    />

    <VersionHistory.panel
      id="note-draft-versions"
      versions={@versions}
      loading={@versions_loading}
      page={@versions_page}
      per_page={@versions_per_page}
      total={@versions_total}
      preview_id={@preview_version_id}
      master_ids={@version_masters}
      empty_hint={gettext("Edits to this draft will be recorded here.")}
    />
  </.modal>

  <.live_component
    :if={@url_state}
    module={MishkaGervaz.Table.Web.Live}
    id="note-drafts-table"
    resource={MishkaDocument.NoteDraft}
    current_user={@current_user}
    url_state={@url_state}
  >
    <:filter_actions>
      <button
        type="button"
        id="add-note-draft-btn"
        phx-click={show_form_modal("note-draft-form-modal", MishkaDocument.NoteDraft)}
        class="inline-flex h-[42px] items-center gap-2 rounded-xl bg-[linear-gradient(140deg,#6d69e6,#4f4bcc)] px-4 text-[12.5px] font-bold text-white shadow-[0_5px_14px_rgba(79,75,204,0.28)] transition-opacity hover:opacity-95"
      >
        <.icon name="hero-plus" class="size-4" /> {gettext("Add Note Draft")}
      </button>
    </:filter_actions>
  </.live_component>
</div>
